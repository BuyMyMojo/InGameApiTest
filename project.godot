; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="InGameApiTest"
run/main_scene="uid://cxwhskbhdia2b"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/appimage_export_plugin/plugin.cfg", "res://addons/nap_map_generator/plugin.cfg", "res://addons/rest_api_server/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

environment/screen_space_reflection/half_size=false
anti_aliasing/quality/use_taa=true
